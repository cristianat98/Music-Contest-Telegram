[Unit]
Description=Music Contest Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/musiccontestbot/musiccontestbot.env
ExecStart=/opt/musiccontestbot/musiccontestbot-pi
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
